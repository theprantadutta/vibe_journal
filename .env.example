# Copy this file to .env and replace with your actual values

# API Configuration
# Production URL is used in release builds, development URL in debug/profile builds
PROD_API_BASE_URL=https://your-production-server.com/your-app
DEV_API_BASE_URL=http://localhost:8000

# Google Sign In Configuration
# Web Client ID from Firebase Console
# Found at: Firebase Console > Project Settings > General
# Or in google-services.json under oauth_client where client_type is 3
GOOGLE_WEB_CLIENT_ID=your-project-id.apps.googleusercontent.com
